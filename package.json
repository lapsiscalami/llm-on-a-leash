{
  "name": "llm-on-a-leash",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Constraint-first patterns for LLM games, learned on 8B models.",
  "type": "module",
  "scripts": {
    "demo:deck": "tsx demos/01-deck/run.ts",
    "demo:classify": "tsx demos/02-classify/run.ts",
