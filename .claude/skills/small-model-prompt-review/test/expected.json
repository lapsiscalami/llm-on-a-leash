        { "check": "3 choices: asked for variety", "what": "fresh, creative twist / vary", "anyOf": ["vary", "fresh", "twist", "deck", "variety"] },
        { "check": "3 choices: pick one of N", "what": "kind is a 3-way pick with no One of: prefix", "anyOf": ["kind"] },
